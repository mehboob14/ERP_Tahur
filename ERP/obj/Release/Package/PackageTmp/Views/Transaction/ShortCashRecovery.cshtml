<script>
    document.getElementById("PageHeader").innerHTML = "Short Cash Recovery";

    $("#SearchAutoComplete").show("true");

    document.getElementById("PageTitle").innerHTML = "Short Cash Recovery";
</script>

<script>

    $(function () {

        $("#PartyCode").chosen();
        $("#RegionCode").chosen();
        $("#EmpCode").chosen();

        $('#ItemTable tbody tr').remove();
    });

    function ChangeOfType() {
        var Type = $("#Type").val();
        if (Type === "Cheq" || Type === "IBFT") {
            $("#CheqNo").attr("readonly", false);
            $("#CheqDate").attr("disabled", false);
        } else {
            $("#CheqNo").attr("readonly", true);
            $("#CheqDate").attr("disabled", true);
        }
    }

    $(function () {

        var RecDate = $("#SessionRecDate").val();
        var RegionCode = $("#SessionRegionCode").val();
        var EmpCode = $("#SessionEmpCode").val();

        $("#RecDate").val(RecDate);


        $("table#ItemTable tbody").find('tr').each(function () {

            var tableItem = document.getElementById('ItemTable');
            var CountRows = $('#ItemTable tbody').find('tr').length;
            var itemList = $(this).find("td");
            // check empty row
            var rows = tableItem.rows;
            var firstRow = rows[1];


            if (firstRow.innerText == "No matching records found") {
                $('#ItemTable tbody tr').remove();
            }
        });


        var row = '<tr><td class="width20"><div class="R"><select class="form-control Reg"></select></div></td><td class="width30"><div class="P"><select class="Par form-control"></select></div></td><td class="width10"><div class="E"><select class="Emp form-control"></select></div></td><td class="width10"><input class="form-control" name="RecoveryAmount" onkeyup="CalTotalAll()" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" type="number" maxlength="15" value="' +
            0 + '"/></td><tr>';


        $("#ItemTable tbody").append(row);

        $.ajax({
            type: "POST",
            url: "/Transaction/GetRegionListDDL",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({}),
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (data) {

                if (data.RDDL.length > 0) {
                    $('.Reg').empty().trigger('change');

                    //$('.Reg').append($('<option>', {
                    //    value: '',
                    //    text: "Select Any Value"
                    //}));

                    $.each(data.RDDL, function (index, obj) {
                        $('.Reg').append($('<option>', {
                            value: obj.RegionCode,
                            text: obj.RegionDescription
                        }));
                    });

                    $(".Reg option[value=" + RegionCode + "]").attr('selected', true);


                }
            }
        });


        $.ajax({
            type: "POST",
            url: "/Transaction/GetRegionPartyFast",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({ RegionCode: RegionCode }),
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (data) {
                $('.Par').empty().trigger("change");

                if (data.length > 0) {
                    $.each(data, function (index, obj) {

                        $('.Par').append($('<option>', {
                            value: obj.PartyCode,
                            text: parseInt(obj.PartyCode) + "  ==>  " + obj.PartyName
                        })).trigger("change");

                        //rIndex.find('.Par').select2('data', {
                        //    id: obj.PartyCode,
                        //    text: obj.PartyCode + "  ==>  " + obj.PartyName
                        //});

                    });
                }
            }
        });



        $.ajax({
            type: "POST",
            url: "/Transaction/GetRegionParty",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({ RegionCode: RegionCode }),
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (data) {
                $('.Emp').empty().trigger("change");

                if (data.length > 0) {
                    $.each(data, function (index, obj) {

                        $('.Emp').append($('<option>', {
                            value: obj.EmpCode,
                            text:  obj.EmpName
                        })).trigger("change");

                    });

                    $(".Emp option[value=" + EmpCode + "]").attr('selected', true);

                }
            }
        });






    });

    
    function AddNewRow() {

        $("table#ItemTable tbody").find('tr').each(function () {

            var tableItem = document.getElementById('ItemTable');
            var CountRows = $('#ItemTable tbody').find('tr').length;
            var itemList = $(this).find("td");
            // check empty row
            var rows = tableItem.rows;
            var firstRow = rows[1];


            if (firstRow.innerText == "No matching records found") {
                $('#ItemTable tbody tr').remove();
            }
        })


        var row = '<tr><td class="width20"><div class="R"><select class="form-control Reg"></select></div></td><td class="width30"><div class="P"><select class="Par form-control"></select></div></td><td class="width10"><div class="E"><select class="Emp form-control"></select></div></td><td class="width10"><input class="form-control" name="RecAmount" onkeyup="CalTotalAll()" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" type="number" maxlength="15" value="' +
            0 + '"/></td><tr>';


        $("#ItemTable tbody").append(row);

        $.ajax({
            type: "POST",
            url: "/Transaction/GetRegionListDDL",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({}),
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (data) {

                if (data.RDDL.length > 0) {
                    //$('.Reg').empty().trigger('change');

                    $('.Reg').append($('<option>', {
                        value: '',
                        text: "Select Any Value"
                    }));

                    $.each(data.RDDL, function (index, obj) {
                        $('.Reg').append($('<option>', {
                            value: obj.RegionCode,
                            text: obj.RegionDescription
                        }));
                    });
                }
            }
        });

       

    }

    function CalTotalAll() {

        var TotalRecovery = 0;
        

        var CountRows = $('#ItemTable tbody').find('tr').length;

        if (CountRows !== 0) {

            $("table#ItemTable tbody").find('tr').each(function () {
                var tableItem = document.getElementById('ItemTable');

                var RecAmount = $(this).find("input[name='RecoveryAmount']").val();

                //if (itemCount != 0) {
                var itemList = $(this).find("td");
                // check empty row
                var rows = tableItem.rows;
                var firstRow = rows[1];

                if (RecAmount !== undefined) {
                    TotalRecovery += parseFloat(RecAmount);
                }

            });

            document.getElementById("TtlRecovery").value = TotalRecovery;

        } else {

            document.getElementById("TtlRecovery").value = 0;
        }
        
    }




    $("#ItemTable").on('change', '.Reg', function () {
        rIndex = $(this).closest('tr');
        index = $(this).closest('tr')[0].rowIndex;

        var RegionCode = rIndex.find('.Reg option:selected').val();

        $.ajax({
            type: "POST",
            url: "/Transaction/GetRegionPartyFast",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({ RegionCode: RegionCode }),
            contentType: "application/json; charset=utf-8",
            async:false,
            success: function (data) {
                rIndex.find('.Par').empty().trigger("change");

                if (data.length > 0) {
                    $.each(data, function (index, obj) {

                        rIndex.find('.Par').append($('<option>', {
                            value: obj.PartyCode,
                            text: parseInt(obj.PartyCode) + "  ==>  " + obj.PartyName
                        })).trigger("change");

                        //rIndex.find('.Par').select2('data', {
                        //    id: obj.PartyCode,
                        //    text: obj.PartyCode + "  ==>  " + obj.PartyName
                        //});

                    });
                }
            }
        });

        $.ajax({
            type: "POST",
            url: "/Transaction/GetRegionParty",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({ RegionCode: RegionCode }),
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (data) {
                rIndex.find('.Emp').empty().trigger("change");

                if (data.length > 0) {
                    $.each(data, function (index, obj) {

                        rIndex.find('.Emp').append($('<option>', {
                            value: obj.EmpCode,
                            text:  obj.EmpName
                        })).trigger("change");

                        //rIndex.find('.Emp').select2('data', {
                        //    id: obj.EmpCode,
                        //    text: obj.EmpCode + "  ==>  " + obj.EmpName
                        //});

                    });
                }
            }
        });
    });


    function GetRecDetail() {

        var GetRecDate = $("#GetRecDate").val();

        $.ajax({
            type: "POST",
            url: "/Transaction/GetShortCashRecoveryDetail",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({ RecDate: GetRecDate }),
            contentType: "application/json; charset=utf-8",
            complete: function (data) {
                if (data.responseJSON.RecDetail.length > 0 && data.responseJSON.UpdTrue == "Update") {
                    $("#tblInvoice tbody tr").remove();

                    $.each(data.responseJSON.RecDetail, function (index, obj) {

                        var row = '<tr class="RecClick" ><td style="font-size:large">' + obj.Id + '</td><td style="font-size:large"> ' + obj.RecDate + '</td><td style="text-align:center;font-size:large"> ' + obj.RegionDesc +

                            '</td><td style="text-align:center;font-size:large"> ' + obj.PartyDesc + '</td></tr>';

                        $("#tblInvoice tbody").append(row);

                    });

                }
                else if (data.responseJSON.RecDetail.length == 0 && data.responseJSON.UpdTrue == "Update") {

                    $("#tblInvoice tbody tr").remove();

                    var row = '<tr class="DamageFunction" ><td colspan="4" style="font-size:large;text-align:center">' + "No Record Fouond . . . !" + '</td></tr>';

                    $("#tblInvoice tbody").append(row);

                }
                else {

                    $("#tblInvoice tbody tr").remove();

                    var row = '<tr class="DamageFunction" ><td colspan="4" style="font-size:large;text-align:center">' + "You Have No Update Rights.Contact to Administrator . . . !" + '</td></tr>';

                    $("#tblInvoice tbody").append(row);

                }
            }
        });

    }


</script>



<script>
    var ItemTable = []

    function checkAllEmptyInputs() {
        var isEmpty = false,
            RecDate = document.getElementById('RecDate').value,
            CheqNo = document.getElementById('CheqNo').value,
            CheqDate = document.getElementById('CheqDate').value

        if (RecDate == "") {
            alert('Rec Date cannot be Empty');
            isEmpty = true;
        }
       
        else
        {
            if (CheqNo != "") {
                if (CheqDate == "") {
                    alert('Cheq Date cannot be Empty');
                    isEmpty = true;
                }

            }
        }

        return isEmpty;
    }

    function ItemRows() {
        ItemTable = [];
        itemCount = 0;
        $("table#ItemTable").find('tr').each(function () {
            var tableItem = document.getElementById('ItemTable');
            var RecAmount = $(this).find("input[name='RecoveryAmount']").val();

            var RegionCode = $(this).find(".Reg option:selected").val();
            var PartyCode = $(this).find(".Par option:selected").val();
            var EmpCode = $(this).find(".Emp option:selected").val();

            if (RegionCode != null) {

                var vouch = {
                    RegionCode: RegionCode, PartyCode: PartyCode, EmpCode: EmpCode, RecoveryAmount: parseFloat(RecAmount)
                };
                ItemTable.push(vouch);
            }
            itemCount++;
        })


    }

    $("#btnSave").click(function (e) {
        e.preventDefault();
        var CheqNo = $("#CheqNo").val();
        var Id = $("#Id").val();

        if (CheqNo !== '' && Id == '') {

            $.ajax({
                type: "POST",
                url: "/Transaction/CheckSCRecoveryCheq",
                dataType: "json",
                contentType: 'application/json',
                data: JSON.stringify({ CheqNo: CheqNo }),
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data == true) {
                        swal({
                            title: "Duplicate CheqNo Found!",
                            text: "Cheq No Already Exist,Please Choose Another Cheq No.",
                            type: "warning"
                        }, function () {
                            isEmpty = true;
                        });
                        isEmpty = true;
                    }
                    else {

                        if (!(checkAllEmptyInputs())) {
                            ItemRows();

                            $.ajax({
                                type: "POST",
                                url: "/Transaction/GetSCRecoveryDetail",
                                dataType: "json",
                                contentType: 'application/json',
                                data: JSON.stringify({ ItemTable: ItemTable }),
                                contentType: "application/json; charset=utf-8",
                                complete: function (data) {

                                    document.forms["ShortCashRecovery"].submit();
                                }
                            });

                        }
                    }

                }
            });
        }
        else {
            if (!(checkAllEmptyInputs())) {
                ItemRows();

                $.ajax({
                    type: "POST",
                    url: "/Transaction/GetSCRecoveryDetail",
                    dataType: "json",
                    contentType: 'application/json',
                    data: JSON.stringify({ ItemTable: ItemTable }),
                    contentType: "application/json; charset=utf-8",
                    complete: function (data) {

                        document.forms["ShortCashRecovery"].submit();
                    }
                });

            }
        }
    });







</script>

<script>

    $("table#tblInvoice").on('click', '.RecClick', function () {

        rIndex = $(this).closest('tr');
        index = $(this).closest('tr')[0].rowIndex;

        var Id = rIndex.find('td:eq(0)').text().replace(/\s+/g, "");
        var RecoveryDate = rIndex.find('td:eq(1)').text().replace(/\s+/g, "");


        document.getElementById("Id").value = Id;
        document.getElementById("RecDate").value = RecoveryDate;
        var RegionCode;
        var PartyCode;
        var EmpCode;
        var PartyDesc;
        var EmpName;

        $.ajax({
            type: "POST",
            url: "/Transaction/GetSingleSCRecovery",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({ Id: Id }),
            contentType: "application/json; charset=utf-8",
            complete: function (ItemList) {
                if (ItemList.responseJSON.length > 0) {
                    $("#ItemTable tbody tr").remove();

                    var ttlRec = 0;

                    $.each(ItemList.responseJSON, function (index, obj) {


                        if (obj.CheqNo !== null) {
                            document.getElementById("CheqNo").value = obj.CheqNo;
                            document.getElementById("CheqDate").value = formatDate(obj.CheqDate);
                        }
                        //document.getElementById("CheqDate").value = obj.CheqDate;

                        document.getElementById("Type").value = obj.Type;

                        ChangeOfType();

                        RegionCode = obj.RegionCode

                        PartyCode = obj.PartyCode;
                        EmpCode = obj.EmpCode;

                        var row = '<tr><td class="width20"><div class="R"><select class="form-control Reg"></select></div></td><td class="width30"><div class="P"><select class="Par form-control"></select></div></td><td class="width10"><div class="E"><select class="Emp form-control"></select></div></td><td class="width10"><input class="form-control" name="RecoveryAmount" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" type="number" onkeyup="CalTotalAll()" maxlength="15" value="' +
                            obj.RecAmount + '"/></td><tr>';

                        ttlRec += obj.RecAmount;

                        $("#ItemTable tbody").append(row);

                        $('.Par').append($('<option>', {
                            value: obj.PartyCode,
                            text: obj.PartyDesc
                        })).trigger("change");

                        $('.Emp').append($('<option>', {
                            value: obj.EmpCode,
                            text: obj.EmpName
                        })).trigger("change");

                    });

                    document.getElementById("TtlRecovery").value = ttlRec;

                    $.ajax({
                        type: "POST",
                        url: "/Transaction/GetRegionListDDL",
                        dataType: "json",
                        contentType: 'application/json',
                        data: JSON.stringify({}),
                        contentType: "application/json; charset=utf-8",
                        async: false,
                        success: function (data) {

                            if (data.RDDL.length > 0) {
                                $('.Reg').empty().trigger('change');

                                $.each(data.RDDL, function (index, obj) {
                                    $('.Reg').append($('<option>', {
                                        value: obj.RegionCode,
                                        text: obj.RegionDescription
                                    }));
                                });

                                $(".Reg option[value=" + RegionCode + "]").attr('selected', true);


                            }
                        }
                    });
                }

                $("#RecoveryModal").modal("hide");
            }
        });
    })

</script>

<script type="text/javascript">

    //Warning Message
    function DeleteModal() {
        var Id = $('#Id').val();
        var Url = "/Transaction/DeleteSCRecovery";

        if (Id == null || Id == "") {
            alert("Region Code Cannot be empty . . . !");
        }
        else
        {
            swal({
                title: "Are you sure?",
                text: "You will not be able to recover this record . . . !",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, delete it...!",
                closeOnConfirm: false
            }, function () {
                $.ajax({
                    type: "POST",
                    url: Url,
                    dataType: "json",
                    contentType: 'application/json',
                    data: JSON.stringify({ Id: Id }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data == true) {
                            swal({
                                title: "Deleted!",
                                text: "Your record has been deleted.",
                                type: "success"
                            }, function () {
                                location.reload();
                            });
                        }
                        else {
                            swal({
                                title: "Not Deleted!",
                                text: "Something went wrong, Record not deleted . . . !",
                                type: "warning"
                            }, function () {
                                location.reload();
                            });
                        }
                    }
                });
            })
        }
    }




</script>

