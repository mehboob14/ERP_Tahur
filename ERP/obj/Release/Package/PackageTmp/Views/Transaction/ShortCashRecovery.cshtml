<div class="row">
    <div class="col-lg-12">
        <form action="/Transaction/ShortCashRecovery" method="post" id="ShortCashRecovery" name="ShortCashRecovery">
            <div class="white-box">
                @if (TempData["SuccessMsg"] != null)
                {
                    <div class="alert alert-success">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <b> @TempData["SuccessMsg"]</b>
                    </div>
                }

                <input type="hidden" id="SessionRecDate" value="@Session["SessSCRecDate"]" />
                <input type="hidden" id="SessionRegionCode" value="@Session["SessSCRecRegionCode"]" />
                <input type="hidden" id="SessionEmpCode" value="@Session["SessSCRecEmpCode"]" />

                <div class="row">

                    <label for="example-text-input" class="col-md-1 col-form-label">Recovery No</label>
                    <div class="col-md-2 input-group">
                        <div class="input-group-addon"><a data-toggle="modal" data-target="#RecoveryModal" style="color:blue"><b><i class="fa fa-search"></i></b></a></div>
                        <input class="form-control" type="text" placeholder="Receipt No" id="Id" name="Id" readonly>
                    </div>

                    <label for="example-text-input" class="col-md-1 col-form-label">Rec Date</label>
                    @if (ERP.Models.CommonDAL.UserRoleName() == "Admin")
                    {
                        <div class="col-md-2 input-group">
                            <input class="form-control Datepicker-AutoCloseAdmin" type="text" placeholder="dd/mm/yyyy" id="RecDate" autocomplete="off" data-mask="99/99/9999" name="RecDate" readonly>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-2 input-group">
                            <input class="form-control Datepicker-AutoCloseDEO" type="text" placeholder="dd/mm/yyyy" id="RecDate" autocomplete="off" data-mask="99/99/9999" name="RecDate" readonly>
                        </div>
                    }


                        <select class="col-md-1 input-group" id="Type" name="Type" onchange="ChangeOfType()">
                            <option value="Cash">Cash</option>
                            <option value="Cheq">Cheq</option>
                            <option value="Bill">Bill</option>
                            <option value="IBFT">Online/IBFT</option>
                        </select>

                </div>
                <div class="row Top">

                    <label for="example-text-input" class="col-md-1 col-form-label">Cheq No</label>
                    <div class="col-md-2 input-group">
                        <input class="form-control" type="text" placeholder="ChequeNo" id="CheqNo" name="CheqNo" readonly>
                    </div>
                    <label for="example-text-input" class="col-md-1 col-form-label">Cheq Date</label>
                    <div class="col-md-2 input-group">
                        <input class="form-control Datepicker-AutoCloseAdmin" type="text" placeholder="Cheq Date" id="CheqDate" name="CheqDate" readonly disabled>
                    </div>

                    <input type="button" class="btn btn-info" value="Add" onclick="AddNewRow()" style="height:30px" />

                    <label for="example-text-input" class="col-md-1 col-form-label" style="margin-left:50px"><b>Total:</b></label>
                    <div class="col-md-1 input-group">
                        <input class="form-control" type="number" placeholder="Recovery" id="TtlRecovery" name="TtlRecovery" readonly>
                    </div>


                </div>

                <div class="col-sm-12">
                    <div class="white-box">
                        <div class="table-responsive">
                            <table id="ItemTable" data-toggle="table" data-height="400" data-mobile-responsive="true" class="table-striped">
                                <thead class="bg-info">
                                    <tr>
                                        <th class="width20 White">Region</th>
                                        <th class="width30 White">Party</th>
                                        <th class="width10 White">Salesman</th>
                                        <th class="width10 White">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>

                                   

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!--Buttons For Actions-->
                <div class=" row Top">
                    <div class="col-sm-12 col-xs-12">
                        <div class="input-group col-md-3 offset-md-9">
                            <div class="input-group">

                                @if (ERP.Models.CommonDAL.UserRights("8", "002"))
                                {
                                    <input class="btn btn-info Btn-width" type="button" id="btnSave" value="Save" style="margin-left:5px" />
                                }
                                else
                                {
                                    <input class="btn btn-info Btn-width" type="button" id="btnSave" value="Save" style="margin-left:5px" disabled />
                                }

                                &nbsp;

                                @if (ERP.Models.CommonDAL.UserRights("8", "004"))
                                {
                                    <input class="btn btn-danger Btn-width" type="button" id="btnDelete" onclick="DeleteModal()" value="Delete" />
                                }
                                else
                                {
                                    <input class="btn btn-danger Btn-width" type="button" id="btnDelete" onclick="DeleteModal()" value="Delete" disabled />
                                }
                                &nbsp;
                                <input class="btn btn-default Btn-width" type="button" id="btnClear" value="Clear" />
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>











<!--Invoice Record-->
<div class="modal fade" tabindex="-1" id="RecoveryModal" role="dialog" aria-labelledby="modal123Label" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="margin-top:50px; height:700px;width:800px">
            <div class="modal-header">
                <b>Recovery Detail</b>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <div class="col-md-9 input-group">
                        <input class="form-control Datepicker-AutoClose" type="text" placeholder="dd/mm/yyyy" name="GetRecDate" id="GetRecDate" value="" data-mask="99/99/9999">

                    </div>

                    <div class="col-md-2 input-group">
                        <input type="button" class="btn btn-info" value="Get Detail" onclick="GetRecDetail()" />
                    </div>
                    <div class="white-box table-Scroll">
                        <table id="tblInvoice" class="table table-striped table-bordered">
                            <thead>
                                <tr class="bg-info">
                                    <th class="width20" style="Color:White">Recovery No</th>
                                    <th class="width20" style="Color:White">Recovery Date</th>
                                    <th class="width50" style="Color:White">Region Desc</th>
                                    <th class="width50" style="Color:White">Party Desc</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                </div>

            </div>
        </div>

        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>


