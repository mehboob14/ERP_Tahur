    $("table#tblItem").on('click', '.SaveItem', function () {

        $('#tblItem tbody tr').remove();

        $('#tblItem tbody').append('<tr><td colspan="6" style="text-align:center"><img src="/Content/spinner.gif" height="50" width="50" /></td></tr>');

        
        
        rIndex = $(this).closest('tr');
        index = $(this).closest('tr')[0].rowIndex;

        let XPos = $("#XPos").val();
        var AccountCode = rIndex.find(".BL option:selected").val();
        var ClearOrBounce = rIndex.find(".BC option:selected").val();

        var CheqNo = rIndex.find('td:eq(1)').text().replace(/\s+/g, "");
        var RecoveryNo = rIndex.find('td:eq(2)').text().replace(/\s+/g, "");
        var RecoveryDate = rIndex.find('td:eq(3)').text().replace(/\s+/g, "");
        var ClearanceDate = rIndex.find("input[name='CleareDate']").val();

        if (AccountCode === "") {
            alert('Bank cannot be Empty');
            rIndex.addClass('duplicate')
        }
        else if (ClearOrBounce === "Pending") {
            alert('Clear or Bounce cannot be Empty');
            rIndex.addClass('duplicate')
        }
        else if (ClearanceDate === '') {
            alert('Clearance Date cannot be Empty');
            rIndex.addClass('duplicate')
        }
        else {

            rIndex.removeClass('duplicate');

            $.ajax({
                type: "POST",
                url: "/Transaction/GetPDCDetail",
                dataType: "json",
                contentType: 'application/json',
                data: JSON.stringify({ CheqNo: CheqNo, RecoveryNo: RecoveryNo, RecoveryDate: RecoveryDate, AccountCode: AccountCode, ClearOrBounce: ClearOrBounce, ClearanceDate: ClearanceDate }),
                contentType: "application/json; charset=utf-8",
                async: false,
                success: function (data) {
                    loadPageData();

                }
            });
            setTimeout(1000);
            var YPos = parseInt(XPos);
            $("#myDIV").scrollTop(YPos);
        }

    });

    $("table#tblItem").on('click', '.DeleteItem', function () {

        rIndex = $(this).closest('tr');
        index = $(this).closest('tr')[0].rowIndex;

        var VoucherNo = rIndex.find('td:eq(0)').text().replace(/\s+/g, "");
        var RecoveryNo = rIndex.find('td:eq(2)').text().replace(/\s+/g, "");
        var RecoveryDate = rIndex.find('td:eq(3)').text().replace(/\s+/g, "");
        var DeleteItem = "Y";


        $.ajax({
            type: "POST",
            url: "/Transaction/GetPDCDetail",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({ VoucherNo: VoucherNo, RecoveryNo: RecoveryNo, RecoveryDate: RecoveryDate, DeleteItem: DeleteItem }),
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (data) {
                loadPageData();
            }
        });

    });


    $("table#tblItem").on('click', '.BL', function () {

