@model ERP.Models.Recovery
@{
    ViewBag.Title = "PDC";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<style>

    tr.duplicate td {
        color: red;
    }

    .White {
        color: white;
    }

    .Black {
        color: black;
    }

    .width50 {
        width: 500px;
    }

    .width40 {
        width: 400px;
    }

    .width15 {
        width: 150px;
    }

    .width30 {
        width: 300px;
    }

    .width20 {
        width: 200px;
    }

    .width10 {
        width: 100px;
    }

    .width5 {
        width: 50px;
    }

</style>

<div class="row">
    <div class="col-lg-12">
        <form action="/Transaction/RecoveryAgainstSale" method="post" id="RecoveryAgainstSale" name="RecoveryAgainstSale">
            <div class="white-box">
                @if (TempData["SuccessMsg"] != null)
                {
                    <div class="alert alert-success">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <b> @TempData["SuccessMsg"]</b>
                    </div>
                }



                    <div class="row">
                        @*<label for="example-text-input" class="col-md-1 col-form-label">Region Code</label>
        <div class="col-md-3 input-group">
            @Html.DropDownListFor(M => M.RegionCode, (IEnumerable<SelectListItem>)ViewBag.RegionDDL as SelectList, "Please Select Region", new { @class = "form-control p-0", @name = "RegionCode", @id = "RegionCode" })
        </div>*@

                        <label for="example-text-input" class="col-md-2 col-form-label" style="margin-left:30px">Recovery Date</label>
                        <div class="col-md-2 input-group">
                            <input class="form-control Datepicker-AutoCloseAdmin" type="text" placeholder="dd/mm/yyyy" id="CheqDate" autocomplete="off" data-mask="99/99/9999" name="CheqDate" value="@Session["PDCFDate"]" readonly>
                        </div>
                        <input class="btn btn-info Btn-width" type="button" value="Get Data" onclick="loadPageData()" style="margin-left:5px" />
                        <input class="btn btn-info Btn-width" type="button" value="Get Pending" onclick="loadPendingPageData()" style="margin-left:5px" />
                        <p id="demo" style="display:none"></p>
                    </div>

                <div class="col-sm-12">
                    <div class="white-box">
                        <input type="hidden" id="XPos" value="0" />
                        <div style="height:600px;overflow-y:scroll" onscroll="MyFunc()" id="myDIV">
                            <table id="tblItem" class="table-striped table-bordered" style="overflow-x:scroll">
                                <thead class="bg-info">
                                    <tr>
                                        <th class="White width20">Vouch No</th>
                                        <th class="White width10">Cheq No</th>
                                        <th class="White width10">Rec/Cheq</th>
                                        @*<th class="White width10">Rec No</th>
        <th class="White width10">Rec Date</th>*@
                                        <th class="White width50">Party</th>
                                        <th class="White width10">Amount</th>
                                        <th class="White width20">Bank/Other/Date</th>
                                        @*<th class="White width20">Clear/Bounce</th>
        <th class="White width20">Clear Date</th>*@
                                        <th class="White width10">Action</th>
                                        <th class="White width10">Print</th>
                                    </tr>
                                </thead>
                                <tbody>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


