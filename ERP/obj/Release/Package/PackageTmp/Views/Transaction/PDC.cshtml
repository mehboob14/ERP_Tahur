                    $.each(data.BDDL, function (index, obj) {
                        rIndex.find('.BL').append($('<option>', {
                            value: obj.Code,
                            text: obj.Name
                        })).trigger("change");
                    });
                }
            }
        });
    });

    $("table#tblItem").on('click', '.PrintItem', function () {

        rIndex = $(this).closest('tr');
        index = $(this).closest('tr')[0].rowIndex;

        var VoucherNo = rIndex.find('td:eq(0)').text().replace(/\s+/g, "");
       
         var baseurl = '@Url.Action("ExportPDCRec","Report")';
        var url = baseurl + '?VoucherRefNo=' + VoucherNo ;
        //window.location.href = url;
        window.open(url, '_blank');
    });

