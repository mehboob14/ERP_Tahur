<div class="row">
    <div class="col-lg-12">
        <div class="white-box">
            <form id="DailyDemand" name="DailyDemand" method="post">
                @if (TempData["SuccessMsg"] != null)
                {
                    <div class="alert alert-success">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <b> @TempData["SuccessMsg"]</b>
                    </div>
                }

                <div class="row">

                    <label for="example-text-input" class="col-md-1 col-form-label">Date</label>
                    <div class="col-md-2 input-group">
                        <div class="input-group-addon"><a data-toggle="modal" data-target="#DSRModal" style="color:blue"><b><i class="fa fa-search"></i></b></a></div>
                        <input class="form-control Datepicker-AutoClose" type="text" placeholder="dd/mm/yyyy" value="@DateTime.Now.ToString("dd/MM/yyyy")" id="DDate" name="DDate" required>
                    </div>
                </div>

                <div class="row Top">
                    <label for="example-text-input" class="col-md-1 col-form-label">Region</label>
                    <div class="col-md-9 input-group">

                        @Html.DropDownListFor(M => M.RegionCode, (IEnumerable<SelectListItem>)ViewBag.RegionDDL as SelectList, "Please Select Region", new { @class = "form-control p-0 select2 m-b-10 select2-multiple", @placeholder = "Select", @multiple = "multiple", @name = "RegionCode", @id = "RegionCode", @onchange = "AutoSelect()" })
                    </div>

                </div>


                <fieldset>
                    <legend>Add Item Quantity</legend>
                    <div class="col-sm-12">
                        <div class="white-box">
                            <table id="ItemTable" data-toggle="table" data-height="350" data-mobile-responsive="true" class="table-striped">
                                <thead class="bg-info">
                                    <tr>
                                        <th class="White" data-width="100"> Item Code </th>
                                        <th class="White"> Item Description </th>
                                        <th class="White" data-width="200"> Quantity </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.ItemList != null)
                                    {
                                        foreach (var item in ViewBag.ItemList)
                                        {
                                            <tr class="GetQty">
                                                <td class="Black">@item.ItemCode</td>
                                                <td class="Black">@item.ItemDesc</td>
                                                <td class="Black">
                                                    <input value="0" name="DemandQty" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                                                           type="number"
                                                           maxlength="15" />
                                                </td>
                                            </tr>
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </fieldset>

                <fieldset>
                    <legend></legend>
                    <div class="form-group row">
                        <div class="col-md-4 offset-md-9">

                            <input class="btn btn-default Btn-width" type="button" id="btnPreview" value="Preview" onclick="PreviewModal()" />

                            @*@if (ERP.Models.CommonDAL.UserRights("505", "002"))
                            {
                                <input class="btn btn-info Btn-width" type="button" id="btnSave" value="Save" />
                            }
                            else
                            {
                                <input class="btn btn-info Btn-width" type="button" id="btnSave" value="Save" disabled />
                            }*@


                            <input class="btn btn-default Btn-width" type="reset" id="btnClear" value="Clear" />

                            @if (ERP.Models.CommonDAL.UserRights("510", "004"))
                            {
                                <input class="btn btn-danger Btn-width" type="button" id="btnDelete" value="Delete" onclick="DeleteModal()" />
                            }
                            else
                            {
                                <input class="btn btn-danger Btn-width" type="button" id="btnDelete" disabled value="Delete" />
                            }

                            @*@if (ERP.Models.CommonDAL.UserRights("505", "006"))
                                {
                                    <input class="btn btn-success Btn-width" type="button" onclick="SimpleInNewWin()" id="btnPrint" value="Print" />
                                }
                                else
                                {
                                    <input class="btn btn-success Btn-width" type="button" onclick="SimpleInNewWin()" id="btnPrint" value="Print" disabled />
                                }*@
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>

<!--DSR Modal-->
<div class="modal fade" tabindex="-1" id="DSRModal" role="dialog" aria-labelledby="modal123Label" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="margin-top:50px; height:620px;width:800px">
            <div class="modal-header">
                <b>Daily Demand Detail</b>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <div class="white-box table-Scroll">
                        <table id="myTable" class="table table-striped DataTable">
                            <thead>
                                <tr>
                                    <th class="width20">Demand Date</th>
                                    <th class="width50">Region Code</th>
                                    <th class="width50">Region Description</th>
                                </tr>
                            </thead>
                            <tbody>

                                @if (ViewBag.DemandList != null)
                                {
                                    foreach (var item in ViewBag.DemandList)
                                    {
                                        <tr onclick="GetDSR('@item.DDate','@item.RegionCode')">
                                            <td>@item.DDate</td>
                                            <td>@item.RegionCode</td>
                                            <td>@item.RegionDesc</td>

                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>

                </div>

            </div>
        </div>

        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>


<!--DSR Modal-->
<div class="modal fade" tabindex="-1" id="PreviewModal" role="dialog" aria-labelledby="modal123Label" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="margin-top:200px; height:620px;width:800px">
            <div class="modal-header">
                <b>Demand Preview</b>
            </div>

            <div class="modal-body">

                <div class="row" style="margin-left:15px">
                    <h3><b>Date:</b></h3> &nbsp;&nbsp; <h3 id="PreviewDate"></h3>

                    &nbsp;&nbsp;&nbsp;&nbsp;

                    <h3><b>Region:</b></h3> &nbsp;&nbsp;  <h3 id="RegionPreview"></h3>
                </div>

                <div class="form-group row">
                    <div class="white-box table-Scroll">
                        <table id="tblPreview" data-toggle="table" data-height="350" data-mobile-responsive="true" class="table-striped">
                            <thead class="bg-info">
                                <tr>
                                    <th class="White" data-width="100">Item Code</th>
                                    <th class="White" data-width="600">Item Description</th>
                                    <th class="White" data-width="100">Quantity</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                </div>

                <div class="container-fluid">
                    @if (ERP.Models.CommonDAL.UserRights("510", "002"))
                    {
                        <input class="btn btn-info Btn-width" type="button" id="btnSave" value="Save" />
                    }
                    else
                    {
                        <input class="btn btn-info Btn-width" type="button" id="btnSave" value="Save" disabled />
                    }

                    <input class="btn btn-danger Btn-width" type="button" id="btnHide" value="Cancel" />
                </div>

            </div>
            

        </div>

        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<script src="~/Content/plugins/bower_components/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">
    document.getElementById("PageHeader").innerHTML = "Daily Demand";



    document.getElementById("PageTitle").innerHTML = "Daily Demand";


    $(function () {
        $("#RegionCode").chosen();

        $("#VehicleCode").chosen();

    })

</script>

<script type="text/javascript">





    function GetDSR(DDate, RegionCode) {
        document.getElementById("DDate").value = DDate;


        $.ajax({
            type: "POST",
            url: "/ProdTransaction/GetSingleDemand",
            dataType: "json",
            contentType: 'application/json',
            data: JSON.stringify({ DDate: DDate, RegionCode: RegionCode }),
            contentType: "application/json; charset=utf-8",
            async: false,
            complete: function (GetSingeDDList) {
                if (GetSingeDDList.responseJSON.length > 0) {
                    $("#ItemTable tbody tr").remove();
                    $.each(GetSingeDDList.responseJSON, function (index, obj) {
                        var row = '<tr><td>' + obj.ItemCode + '</td><td>' + obj.ItemDesc +
                            '</td><td><input name="DemandQty" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" type = "number" maxlength = "15" value="' + obj.DemandQty + '"/></td></tr>';

                        $("#ItemTable tbody").append(row);

                        var array = RegionCode.split(",");

                        $('#RegionCode').val(array);
                        $('#RegionCode').trigger("chosen:updated");

                    });
                    $("#PDModal").modal("hide");
                }
            }
        });


        $("#DSRModal").modal("hide");
    }

    function AutoSelect() {
        var RegionCode = $("#RegionCode").val();
        if (RegionCode == "002" || RegionCode == "003" || RegionCode == "004" || RegionCode == "005") {
            var RArray = ["002", "003", "004", "005"];

            $('#RegionCode').val(RArray);
            $('#RegionCode').trigger("chosen:updated");
        }
    }

    function SimpleInNewWin() {
        var DispatchCode = $("#DispatchCode").val();
        if (DispatchCode == null || DispatchCode == "") {
            alert("Please, Select Dispatch Code . . . !");
        } else {
            window.open("../ReportWebForms/Transaction/DailyDispatch.aspx?DispatchCode=" + encodeURI(DispatchCode), 'mywindow', 'fullscreen=yes, scrollbars=auto');
        }

    }


    function PreviewModal() {
        if (!(checkAllEmptyInputs())) {
            var DDate = $("#DDate").val();
            var SelectedText = $("#RegionCode option:selected").text();

            if (SelectedText.length >= 50) {
                SelectedText = "North";
            }

            $("#PreviewDate").html(DDate);
            $("#RegionPreview").html(SelectedText);

            $("#tblPreview tbody tr").remove();

            $("table#ItemTable").find('tr').each(function () {
                var tableItem = document.getElementById('ItemTable');
                var Quantity = $(this).find("input[name='DemandQty']").val();

                var itemList = $(this).find("td");
                // check empty row

                if (Quantity != undefined) {
                    var row = '<tr><td class="Black"><b>' + $(itemList[0]).html() + '</b></td><td class="Black"><b>' + $(itemList[1]).html() + '</b></td><td class="Black"><b>' + parseFloat(Quantity) + '</b></td></tr >';
                }

                $("#tblPreview tbody").append(row);
            })

            $("#PreviewModal").modal("show");
        }
    }

    function checkAllEmptyInputs() {
        var isEmpty = false,
            RegionCode = document.getElementById('RegionCode').value
           

        if (RegionCode == "") {
            alert('Region Code cannot be Empty');
            isEmpty = true;
        }

        return isEmpty;
    }

</script>

<script>
    var ItemTable = []

    function ItemRows() {

        itemCount = 0;
        $("table#ItemTable").find('tr').each(function () {
            var tableItem = document.getElementById('ItemTable');
            var Quantity = $(this).find("input[name='DemandQty']").val();

            if (itemCount != 0) {
                var itemList = $(this).find("td");
                // check empty row

                var vouch = {
                    ItemCode: $(itemList[0]).html(), ItemDesc: $(itemList[1]).html(), DemandQty: parseFloat(Quantity)
                };
                ItemTable.push(vouch);
            }
            itemCount++;
        })


    }

    $("#btnSave").click(function (e) {

        if (!(checkAllEmptyInputs())) {
            e.preventDefault();
            CheckDupModal();
           
        }
    });





    //Warning Message
    function DeleteModal() {
        var Id = $('#DDate').val();
        var RegionCode = $('#RegionCode').val();
        var Url = "/ProdTransaction/DeleteDemand";

        if (Id == null || Id == "") {
            alert("Please, Select Dispatch Code . . . !");
        } else {
            swal({
                title: "Are you sure?",
                text: "You will not be able to recover this record . . . !",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, delete it...!",
                closeOnConfirm: false
            }, function () {
                $.ajax({
                    type: "POST",
                    url: Url,
                    dataType: "json",
                    contentType: 'application/json',
                    data: JSON.stringify({ DDate: Id, RegionCode: RegionCode }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data == true) {
                            swal({
                                title: "Deleted!",
                                text: "Your record has been deleted.",
                                type: "success"
                            }, function () {
                                location.reload();
                            });
                        }
                        else {
                            swal({
                                title: "Not Deleted!",
                                text: "Something went wrong, Record not deleted . . . !",
                                type: "warning"
                            }, function () {
                                location.reload();
                            });
                        }
                    }
                });
            })
        }

    }





    //Warning Message
    function CheckDupModal() {
        var DDate = $('#DDate').val();
        var RegionCode = $('#RegionCode').val();
        var Url = "/ProdTransaction/CheckDuplicateDemand";

        if (DDate == null || DDate == "") {
            alert("Please, Select Dispatch Code . . . !");
        } else {
            $.ajax({
                type: "POST",
                url: Url,
                dataType: "json",
                contentType: 'application/json',
                data: JSON.stringify({ DDate: DDate, RegionCode: RegionCode }),
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.data == true) {
                        swal({
                            title: "Duplicate Entry Found...",
                            text: "If you want to update this record, Click Yes Button . . . !",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#DD6B55",
                            confirmButtonText: "Yes, Update it...!",
                            closeOnConfirm: false
                        }, function () {

                            
                                ItemRows();

                                $.ajax({
                                    type: "POST",
                                    url: "/ProdTransaction/DailyDemandDetail",
                                    dataType: "json",
                                    contentType: 'application/json',
                                    data: JSON.stringify({ ItemQuantity: ItemTable }),
                                    contentType: "application/json; charset=utf-8",
                                    complete: function (data) {
                                        document.forms["DailyDemand"].submit();
                                    }
                                });
                           
                           
                        })
                    } else {
                        ItemRows();

                        $.ajax({
                            type: "POST",
                            url: "/ProdTransaction/DailyDemandDetail",
                            dataType: "json",
                            contentType: 'application/json',
                            data: JSON.stringify({ ItemQuantity: ItemTable }),
                            contentType: "application/json; charset=utf-8",
                            complete: function (data) {
                                document.forms["DailyDemand"].submit();
                            }
                        });
                    }

                }
            });

        }

    }

</script>

