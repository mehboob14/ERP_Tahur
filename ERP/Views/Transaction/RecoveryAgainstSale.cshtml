                var RecDiscount = $(this).find("input[name='RecDiscount']").val();

                //if (itemCount != 0) {
                var itemList = $(this).find("td");
                // check empty row
                var rows = tableItem.rows;
                var firstRow = rows[1];

                if (RecAmount !== undefined && RecWHT !== undefined && RecDiscount !== undefined) {
                    TotalRecovery += parseFloat(RecAmount);
                    TotalWHT += parseFloat(RecWHT);
                    TotalDiscount += parseFloat(RecDiscount);
                }
                
            });

            document.getElementById("TtlRecovery").value = TotalRecovery;
            document.getElementById("TtlWHT").value = TotalWHT;
            document.getElementById("TtlDiscount").value = TotalDiscount;

        } else {

            document.getElementById("TtlRecovery").value = 0;
