    $("#btnSave").click(function (e) {
        e.preventDefault();
        var CheqNo = $("#CheqNo").val();
        var RecoveryNo = $("#RecoveryNo").val();

        if (CheqNo !== '' && RecoveryNo == '') {

            $.ajax({
                type: "POST",
                url: "/Transaction/CheckRecoveryCheq",
                dataType: "json",
                contentType: 'application/json',
                data: JSON.stringify({ CheqNo: CheqNo }),
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data == true) {
                        swal({
                            title: "Duplicate CheqNo Found!",
