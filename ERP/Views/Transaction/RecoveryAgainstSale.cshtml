                            type: "warning"
                        }, function () {
                            isEmpty = true;
                        });
                        isEmpty = true;
                    }
                    else {

                        if (!(checkAllEmptyInputs())) {
                            ItemRows();

                            $.ajax({
                                type: "POST",
                                url: "/Transaction/GetRecoveryDetail",
                                dataType: "json",
                                contentType: 'application/json',
                                data: JSON.stringify({ ItemTable: ItemTable }),
                                contentType: "application/json; charset=utf-8",
                                complete: function (data) {

                                    document.forms["RecoveryAgainstSale"].submit();
