@model ERP.Models.HR_DepartmentInfo

@{
    ViewBag.Title = "HR_DepartmentList";
    Layout = "~/Views/Shared/_HR_Layout.cshtml";
}

@if (ERP.Models.CommonDAL.UserRights("1502", "002"))
{
    <div class="card mb-3">
        <div class="card-body pt-0">

            <form action="/HR/HR_CreateEdit_DepartmentList" method="post">
                <div class="row">



                    <div class="form-group mt-1 col-md-2">
                        <label class="control-label col-md-12">Code</label>
                        <div class="col-md-12">
                            <input class="form-control form-control-sm" type="number" id="DepCode" name="DepCode" value="0" readonly />
                        </div>
                    </div>

                    <div class="form-group mt-1 col-md-3">
                        <label class="control-label col-md-12">Site</label>
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.SiteCode, (IEnumerable<SelectListItem>)ViewBag.SiteDDL as SelectList, "Select Site", new { @class = "form-select form-select-sm", @name = "SiteCode", @id = "SiteCode", @Required = "Required" })
                        </div>
                    </div>

                    <div class="form-group mt-1 col-md-7">
                        <label class="control-label col-md-12">Department Description</label>
                        <div class="col-md-12">
                            <input class="form-control form-control-sm" type="text" id="DepDescription" name="DepDescription" required />
                        </div>
                    </div>

                    <div class="form-group mt-1 col-md-2">
                        <label class="control-label col-md-12">Short Name</label>
                        <div class="col-md-12">
                            <input class="form-control form-control-sm" type="text" id="DepShortName" name="DepShortName" required />
                        </div>
                    </div>

                    <div class="col-md-2" style="margin-top:35px">
                        <button class="btn btn-falcon-success btn-sm" type="submit">
                            <span class="fas fa-download" data-fa-transform="shrink-3 down-2"></span>
                            <span class="ms-1">Submit</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

}


    <div class="card mb-3">
        <div class="card-body pt-0">
            <div class="table-responsive scrollbar">
                <table class="table table-sm table-hover table-striped overflow-hidden" id="tblDepartment">
                    <thead>
                        <tr>
                            <td style="display:none">
                                <b>
                                    Site
                                </b>
                            </td>
                            <td width="150">
                                <b>
                                    Site
                                </b>
                            </td>
                            <td width="50">
                                <b>
                                    Code
                                </b>
                            </td>

                            <td>
                                <b>
                                    Name
                                </b>
                            </td>
                            <td width="100">
                                <b>
                                    Short
                                </b>
                            </td>
                            <td width="100">
                                <b>
                                    Actions
                                </b>
                            </td>
                        </tr>
                    </thead>

                    <tbody>

                        @if (ViewBag.DepartmentList != null)
                        {
                            foreach (var item in ViewBag.DepartmentList)
                            {
                                <tr>
                                    <td style="display:none">
                                        @item.HR_SiteInfo.SiteCode
                                    </td>
                                    <td>
                                        @item.HR_SiteInfo.SiteName
                                    </td>
                                    <td>
                                        @item.DepCode
                                    </td>
                                    <td>
                                        @item.DepDescription
                                    </td>
                                    <td>
                                        @item.DepShortName
                                    </td>
                                    @if (ERP.Models.CommonDAL.UserRights("1502", "003"))
                                    {
                                        <td>
                                            <a class="selectItem" style="color:blue"><i class="fa fa-edit"></i></a>
                                            &nbsp;&nbsp;|&nbsp;&nbsp;
                                            <a class="deleteItem" style="color:red"><i class="fa fa-trash"></i></a>
                                        </td>
                                    }
                                </tr>
                            }
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <script src="~/Content/plugins/bower_components/jquery/dist/jquery.min.js"></script>

    <script>
        $("table#tblDepartment").on('click', '.selectItem', function () {
            rIndex = $(this).closest('tr');
            index = $(this).closest('tr').rowIndex;
            //rIndex = this.rowIndex;
            //console.log(index);
            var SiteCode = rIndex.find('td:eq(0)').text().replace(/\s+/g, "");
            var DepCode = rIndex.find('td:eq(2)').text().replace(/\s+/g, "");
            var DepDescription = rIndex.find('td:eq(3)').text();
            var DepShortName = rIndex.find('td:eq(4)').text();

            document.getElementById('SiteCode').value = SiteCode;
            document.getElementById('DepCode').value = DepCode;
            document.getElementById('DepDescription').value = DepDescription.trim();
            document.getElementById('DepShortName').value = DepShortName.trim();

        });

        $("table#tblDepartment").on('click', '.deleteItem', function () {
            rIndex = $(this).closest('tr');
            index = $(this).closest('tr').rowIndex;

            var DepCode = rIndex.find('td:eq(2)').text().replace(/\s+/g, "");

            if (confirm("Are you sure to want delete . . . ?") == true) {

                $.ajax({
                    type: "POST",
                    url: "/HR/HR_Delete_DepartmentList",
                    dataType: "json",
                    contentType: 'application/json',
                    data: JSON.stringify({ DepCode: DepCode }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {

                        location.reload();

                    }
                });
            }

        });

    </script>

