<div class="row">
    <div class="col-md-12">
        <div class="white-box">
            <form name="EmployeeMaster" role="form" method="post" style="margin-top:20px">
               
                <div class="row">
                    <div class="col-sm-12 col-xs-12">

                        <div class="row Top">
                            <label for="example-text-input" class="col-md-1 offset-2 col-form-label">Region</label>

                            <div class="col-md-6 input-group">
                                @Html.DropDownListFor(M => M.RegionCode, (IEnumerable<SelectListItem>)ViewBag.RegionDDL as SelectList, "Please Select Region", new { @class = "form-control p-0", @name = "RegionCode", @id = "RegionCode" })
                            </div>
                        </div>
                       

                        <div class="form-group row mt-5">
                            <label for="exampleInputuname" class="offset-md-2 col-md-1">From Date</label>
                            <div class="input-group col-md-2">
                                <input type="text" class="form-control Datepicker-AutoClose" autocomplete="off" id="FromDate" placeholder="dd/mm/yyyy">
                            </div>
                            <label for="exampleInputuname" class="col-md-1">To Date</label>
                            <div class="input-group col-md-2">
                                <input type="text" class="form-control Datepicker-AutoClose" autocomplete="off" id="ToDate" placeholder="dd/mm/yyyy">
                            </div>
                        </div>


                        &nbsp;&nbsp;

                        <div class="offset-md-3 col-md-2" style="margin-top:10px">
                            <input type="button" class="btn btn-info" value="Print Preview" onclick="OpenSI()" style="width:130px;height:32px;background: #0067b8;padding:10px" />
                        </div>

                        @*<div class="col-md-1" style="margin-top:10px">
                            <div class="input-group-addon"><a style="color:green" onclick="ExportMultiPrint();"><i class="fa fa-print"></i></a></div>
                        </div>*@
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Scripts-->
<script src="~/Content/plugins/bower_components/jquery/dist/jquery.min.js"></script>

<script>
    document.getElementById("PageHeader").innerHTML = "Salesman Incentive";
    document.getElementById("PageTitle").innerHTML = "Salesman Incentive";

    $("#SearchAutoComplete").show("true");

</script>

<script type="text/javascript">


    function OpenSI() {

        
        var RegionCode = document.getElementById("RegionCode").value;
        var fromdate = document.getElementById("FromDate").value;
        var todate = document.getElementById("ToDate").value;-


        window.open("../ReportWebForms/DetailWebForms/SalesmanIncentive.aspx?RgionCode=" + RegionCode + "&FromDate=" + fromdate + "&ToDate=" + todate, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    $(function () {
        $("#RegionCode").chosen();
       
    });

   

    function CISReportInNewWin() {

        var ManInvoiceNo = document.getElementById("ManInvoiceNo").value;

        $.ajax({
            url: '/Report/ShowSaleTaxInvoice',

            data: JSON.stringify({ ManInvoiceNo: ManInvoiceNo }),
            type: 'POST',
            contentType: 'application/json;',
            dataType: 'json',
            complete: function (data) {
                SimpleInNewWin();
            }
        });
    }

    function ExportMultiPrint() {

         var PartyCode = document.getElementById("PartyCode").value;
        var RegionCode = document.getElementById("RegionCode").value;
        var fromdate = document.getElementById("FromDate").value;
        var todate = document.getElementById("ToDate").value;

         var baseurl = '@Url.Action("/ExportMultiPrint")';
        var url = baseurl + '?FromDate=' + fromdate + '&ToDate=' + todate + '&PartyCode=' + PartyCode + '&RegionCode=' + RegionCode;
        //window.location.href = url;
        window.open(url, '_blank');
    }

    function ExportPrint() {
        var ManInvoiceNo = document.getElementById("ManInvoiceNo").value;

         var baseurl = '@Url.Action("/ExportSaleTaxInvoice")';
        var url = baseurl + '?ManInvoiceNo=' + ManInvoiceNo;
        //window.location.href = url;
        window.open(url, '_blank');
    }


   


    



</script>



